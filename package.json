{
  "name": "SIMPS",
  "version": "1.0.0",
  "description": "Smart Inventory and Procurement Management System for Ramco Institute of Technology",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "demo"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "migrate": "node server/scripts/migrate.js",
    "create-admin": "node server/scripts/create-admin.js",
    "demo:load": "npm run demo:load --workspace=demo",
    "demo:clear": "npm run demo:clear --workspace=demo",
    "demo:status": "npm run demo:status --workspace=demo",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "prettier": "^3.5.3"
  }
}
